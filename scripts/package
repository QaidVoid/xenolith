#!/bin/sh
# Packs a release build of the tool into dist/.
#
# Usage: scripts/package <version> <platform>
#   scripts/package 0.2.0 x86_64-linux
#
# The archive holds the tool, the shader library beside it, the licences and
# the README. The two have to stay side by side: a lift copies the library from
# the directory the tool runs from, and a game built without it cannot have the
# shaders it loads while running translated. Build with cargo build --release
# first.
set -eu

root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd)
cd "$root"

version=$1
platform=$2
name=xenolith-$version-$platform
stage=dist/$name

for built in target/release/xenolith target/release/libxenolith_shader.a; do
    [ -f "$built" ] || {
        printf 'package: %s is not there, build with cargo build --release first\n' "$built" >&2
        exit 1
    }
done

rm -rf dist
mkdir -p "$stage"
cp target/release/xenolith target/release/libxenolith_shader.a "$stage/"
cp README.md LICENSE-MIT LICENSE-APACHE "$stage/"
tar -C dist -cJf "dist/$name.tar.xz" "$name"
rm -rf "$stage"
(cd dist && sha256sum "$name.tar.xz" >"$name.tar.xz.sha256")
printf 'package: dist/%s.tar.xz\n' "$name"
