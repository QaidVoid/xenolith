#!/bin/sh
# Fails when a tracked file is a key, a container, or a disc image, or when a
# tracked file carries a key value.
#
# Nothing this script prints carries the key: a diagnostic names the path and
# the line number of a file that holds one, and nothing else.
set -eu

root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd)
cd "$root"

list=$(mktemp)
hits=$(mktemp)
trap 'rm -f "$list" "$hits"' EXIT INT TERM

if ! jj file list >"$list"; then
    printf 'check-secrets: cannot list the tracked files\n' >&2
    exit 1
fi

failed=0

# A key is thirty two hexadecimal digits. The reader ignores underscores and
# whitespace between them, so the separators are allowed between digits but do
# not count towards the thirty two.
digit='[0-9a-fA-F]'
separators='[[:space:]_]*'
assignment="XENOLITH_XEX_KEY[[:space:]]*=[[:space:]]*[\"']?${separators}${digit}(${separators}${digit}){31}"

# Leaves the matching lines in $hits. Returns 1 when nothing matched, and aborts
# when the file cannot be read, so a failed read is never mistaken for clean.
matches() {
    status=0
    grep -n -a -E -e "$1" -- "./$2" >"$hits" 2>/dev/null || status=$?
    case $status in
        0) return 0 ;;
        1) return 1 ;;
    esac
    printf 'check-secrets: cannot read %s\n' "$2" >&2
    exit 1
}

while IFS= read -r path; do
    case "$path" in
        *.key|*.xex|*.iso|*.bin)
            printf 'check-secrets: %s is a key, a container, or a disc image\n' "$path" >&2
            failed=1
            continue
            ;;
        corpus/*|*/corpus/*|tmpwork/*|*/tmpwork/*)
            printf 'check-secrets: %s is game data or build scratch\n' "$path" >&2
            failed=1
            continue
            ;;
    esac

    if [ ! -f "$path" ]; then
        continue
    fi

    if matches "$assignment" "$path"; then
        while IFS= read -r line; do
            printf 'check-secrets: %s:%s assigns a key value\n' "$path" "${line%%:*}" >&2
        done <"$hits"
        failed=1
    fi
done <"$list"

exit "$failed"
