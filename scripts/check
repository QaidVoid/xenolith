#!/bin/sh
# Runs every gate the project requires before a change is committed.
set -eu

root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd)
cd "$root"

run() {
    name=$1
    shift
    printf 'check: %s\n' "$name"
    if ! "$@"; then
        printf 'check: %s failed\n' "$name" >&2
        exit 1
    fi
}

run format cargo fmt --all --check
run clippy cargo clippy --workspace --all-targets -- -D warnings
run test cargo test --release --workspace
run rustdoc env RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --quiet
run text scripts/check-text
run licence scripts/check-licence
run secrets scripts/check-secrets

# Every name the project ships, on a page. A function in the runtime header or
# the shader crate that no page names is one a reader cannot find.
run docs scripts/check-docs

# Every count the documentation quotes, against a run of the tool. A number
# typed into a page is a claim about what the code did when the page was
# written, and nothing else in the build notices when that stops being true.
if [ -d ../xen/corpus ]; then
    run numbers scripts/check-numbers
else
    printf 'check: numbers skipped, because this machine has no corpus\n'
fi

# The differential against hardware is ignored unless a cross toolchain is
# named, which is right for a machine that has none. Where one is installed the
# skip is the wrong answer, because the only oracle that can see a wrong result
# would then be dark in the gate that decides whether a change lands.
#
# So it runs here when the tools answer, and is left alone when they do not. The
# point is not to require them. It is that having them and not using them is the
# case where the gate quietly stops checking the thing it is strongest at.
if command -v powerpc64-linux-gnu-gcc >/dev/null 2>&1 &&
   command -v qemu-ppc64 >/dev/null 2>&1; then
    run differential env XENOLITH_PPC_TOOLCHAIN=powerpc64-linux-gnu- \
        cargo test --release -p xenolith-lift --test execution -- --include-ignored
else
    printf 'check: differential skipped, because this machine has no cross toolchain\n'
fi

exit 0
